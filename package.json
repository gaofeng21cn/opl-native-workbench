{
  "name": "opl-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "First-party Native candidate shell for One Person Lab App.",
  "license": "Apache-2.0",
  "dependencies": {
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.4",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-web-react": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-tabs": "^1.1.16",
    "@shikijs/langs": "4.3.1",
    "@types/mdast": "4.0.4",
    "anser": "2.3.5",
    "clsx": "2.1.1",
    "katex": "^0.17.0",
    "lucide-react": "^1.23.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "^11.16.1",
    "micromark-core-commonmark": "2.0.3",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-factory-space": "2.0.1",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "micromark-util-types": "2.0.2",
    "pdfjs-dist": "^6.2.108",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-resizable-panels": "^4.12.1",
    "shiki": "4.3.1",
    "streamdown": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "typescript": "5.8.3"
  },
  "scripts": {
    "dev": "node scripts/dev-webui-server.mjs",
    "webui": "node scripts/dev-webui-server.mjs",
    "build": "node scripts/build-renderer.mjs",
    "build:webui": "node scripts/build-webui.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "vendor:dsh-gui": "node scripts/deepseek-harness-gui-vendor.mjs sync",
    "verify:dsh-gui": "node scripts/deepseek-harness-gui-vendor.mjs check",
    "package": "node scripts/package-opl-studio.mjs",
    "smoke:native-live": "node scripts/smoke-native-app-live.mjs",
    "test:native-command-output": "node scripts/native-command-output-regression.mjs",
    "test:native-runtime-resolution": "node scripts/native-runtime-resolution-regression.mjs",
    "test:model-list-pagination": "node scripts/model-list-pagination-regression.mjs",
    "test:thread-list-pagination": "node scripts/thread-list-pagination-regression.mjs",
    "test:gateway-account-projection": "bun run scripts/gateway-account-projection-regression.ts",
    "test:package-projection": "bun test tests/workbench/package-projection.test.mts",
    "test:runtime-projection": "bun test tests/workbench/runtime-projection.test.mts",
    "test:ui-contributions": "bun test tests/workbench/ui-contribution-composition.test.mts",
    "test:storage-migration": "bun test tests/workbench/storage-migration.test.mts",
    "test:thread-directory-projection": "bun test tests/workbench/thread-directory-projection.test.mts",
    "test:webui-host": "node --test scripts/webui-host/thread-adapter.test.mjs scripts/webui-host/http-host.test.mjs scripts/webui-host/opl-passthrough.test.mjs",
    "test:threads": "npm run test:thread-list-pagination && npm run test:thread-directory-projection && npm run test:webui-host && node --test tests/renderer/thread-renderer-source.test.mjs",
    "validate:candidate": "node scripts/validate-opl-studio-candidate.mjs",
    "validate:state-model": "node scripts/validate-state-model.mjs",
    "validate:package": "node scripts/validate-packaged-runtime.mjs",
    "smoke:webui": "node scripts/smoke-webui.mjs",
    "smoke:visual": "node scripts/smoke-visual.mjs",
    "test": "npm run typecheck && npm run test:native-command-output && npm run test:native-runtime-resolution && npm run test:model-list-pagination && npm run test:gateway-account-projection && npm run test:package-projection && npm run test:runtime-projection && npm run test:ui-contributions && npm run test:storage-migration && npm run test:threads && npm run validate:candidate && npm run validate:state-model && npm run smoke:webui && npm run smoke:visual && npm run package && npm run validate:package"
  }
}
