{
  "product_status_owner": "docs/active/current-state-vs-ideal-gap.md",
  "product_development_policy": {
    "role": "first_party_native_successor_implementation",
    "automatic_or_scheduled_work_allowed": false,
    "product_development_required": true,
    "current_mainline": false,
    "minimum_complete_product_obligation": true,
    "aionui_feature_parity_obligation": false,
    "release_blocking": false
  },
  "delivery_evaluation": {
    "role": "lightweight_opl_native_product_target",
    "current_mainline": false,
    "future_mainline_cutover_target": true,
    "renderer_technology": "react",
    "macos_host": "swift_appkit_wkwebview",
    "workspace_host": "node_http_sse",
    "workspace_product_name": "OPL Studio",
    "shared_renderer_and_bridge_shape_required": true,
    "runtime_backend_scope": "codex_cli_only",
    "aionui_runtime_dependency_allowed": false,
    "aioncore_runtime_dependency_allowed": false,
    "cross_platform_wrapper_selection": "deferred_electron_or_tauri",
    "windows_linux_support_claim_allowed": false,
    "release_adoption_requires_separate_app_qualification": true
  },
  "canonical_docs": [
    {
      "path": "README.md",
      "role": "root_entry"
    },
    {
      "path": "AGENTS.md",
      "role": "repo_agent_working_rules"
    },
    {
      "path": "docs/README.md",
      "role": "docs_entry"
    },
    {
      "path": "docs/architecture.md",
      "role": "architecture_boundary"
    }
  ],
  "doc_profile": "tooling_repo",
  "flow_profile": "tooling_repo",
  "machine_truth_surfaces": [
    "contracts",
    "src",
    "tests",
    "package.json"
  ],
  "owned_by_repo": [
    "contracts/**",
    "src/**",
    "tests/**",
    "docs/active/current-state-vs-ideal-gap.md"
  ],
  "plugin_native_status": "profile_declared",
  "repo_id": "opl-studio",
  "repo_profile": "tooling_repo",
  "runtime_dependency_policy": {
    "aioncore_required": false,
    "aionui_required": false,
    "codex_app_server_source": "OPL_CODEX_BIN_or_exact_external_codex",
    "opl_integration": "framework_app_state_action_contracts_only",
    "multi_backend_abstraction_required": false,
    "thread_store_owner": "codex_core_app_server"
  },
  "carrier_policy": {
    "enabled": [
      "codex_app_server_stdio"
    ],
    "reserved_disabled": [
      "pi",
      "hermes"
    ],
    "disabled_carriers_add_runtime_dependencies": false,
    "thread_overview": "thread/list useStateDbOnly=true sortKey=updated_at sortDirection=desc",
    "thread_history": "thread/read includeTurns=true by canonical Codex thread id",
    "thread_store_owner": "codex_core_app_server"
  },
  "schema": "opl_studio_profile.v1",
  "taxonomy_dirs": [
    "docs/active",
    "docs/history"
  ],
  "verification_commands": [
    "package.json:scripts.test",
    "package.json:scripts.build",
    "package.json:scripts.typecheck"
  ]
}
